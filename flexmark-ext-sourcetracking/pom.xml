    <artifactId>flexmark-ext-sourcetracking</artifactId>
    <name>flexmark-java extension for tracking Markdown source positions in rendered HTML</name>
    <description>flexmark-java extension adding source code position attributes (source-offset and source-length) to rendered HTML elements.
                 Enables navigation from Markdown source code to the rendered element in an HTML preview and vice versa.
    </description>

